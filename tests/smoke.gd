extends SceneTree
const Game = preload("res://scripts/game.gd")
func _initialize() -> void:
 var g = Game.new()
 g.new_game(123)
 assert(g.state.condition == 1)
 assert(g.dispatch({"type":"move","soldier":"A","hex":"A1"}).ok)
 assert(g.soldier("A").hex == "A1")
 assert(g.state.blocked == "")
 assert(not g.dispatch({"type":"move","soldier":"A","hex":"T8"}).ok)
 var snap = g.snapshot()
 var restored = Game.new()
 assert(restored.restore(JSON.parse_string(JSON.stringify(snap))))
 assert(restored.soldier("A").hex == "A1")
 var legacy = snap.duplicate(true)
 legacy.erase("evasive_removals")
 legacy.erase("ban_evasive_return")
 legacy.erase("minefields")
 var migrated = Game.new()
 assert(migrated.restore(legacy))
 assert(migrated.soldier("A").hex == "A1")
 assert(migrated.state.minefields.is_empty())
 assert(Game.check_success(0,-5))
 assert(not Game.check_success(9,20))
 var card = g.mission.conditions["1"]
 assert(card.hexes.size() == 475)
 assert(card.events.size() == 19)
 assert(card.hexes["A1"] == "EVENT")
 assert(card.hexes["A2"] == "EVENT")
 assert(card.hexes["G10"] == "s3:328")
 var second = g.mission.conditions["2"]
 assert(second.hexes.size() == 475)
 assert(second.events.size() == 19)
 assert(second.hexes["G10"] == "s3:328")
 assert(second.hexes["M3"] == "s5:192")
 var encounter = Game.new()
 encounter.new_game(77)
 encounter.state.squad[0].hex = "G10"
 encounter.state.context_hex = "G10"
 encounter.state.trigger_soldier = "A"
 encounter.read_reference("s3:328")
 assert("s3" in encounter.state.sightings)
 assert(encounter.soldier("K").hex == "G10")
 var prior_log = encounter.state.log.size()
 encounter.read_reference("s3:328")
 assert(encounter.state.log.size() == prior_log + 1)
 var third = g.mission.conditions["3"]
 assert(third.hexes.size() == 475)
 assert(third.events.size() == 19)
 assert(third.hexes["G10"] == "s3:328")
 var fourth = g.mission.conditions["4"]
 assert(fourth.hexes.size() == 475)
 assert(fourth.events.size() == 19)
 assert(fourth.hexes["T8"] == "027")
 assert(fourth.events["7"] == "s5:611")
 assert(fourth.round_overrides.size() == 46)
 assert(fourth.round_overrides["Y7"] == "EXIT")
 assert(fourth.round_overrides["X6"] == "457")
 assert(fourth.round_overrides_status == "transcribed_visual_review_not_yet_used")
 var evasive = Game.new()
 evasive.new_game(44)
 evasive.state.context_hex = "T8"
 evasive.resolve("027")
 assert(evasive.state.ban_evasive_return)
 assert(evasive.state.blocked == "")
 evasive.resolve("346")
 assert(evasive.state.blocked == "")
 evasive.state.evasive_removals["34"] = 1
 evasive.resolve("346")
 assert(evasive.state.last_paragraph == "611")
 assert(evasive.state.blocked != "")
 var wreck = Game.new()
 wreck.new_game(50)
 wreck.state.squad[0].hex = "R15"
 wreck.state.context_hex = "R15"
 wreck.resolve("613")
 assert(wreck.soldier("A").status == "active")
 assert("s0" not in wreck.state.sightings)
 wreck.resolve("453")
 assert(wreck.soldier("A").status == "killed")
 assert(wreck.state.landmarks.has("R15"))
 wreck.resolve("613")
 assert("s0" in wreck.state.sightings)
 assert(not wreck.state.landmarks.has("R15"))
 var mine = Game.new()
 mine.new_game(60)
 mine.state.condition = 4
 mine.state.squad[0].hex = "U6"
 mine.forced_rolls = [0]
 assert(mine.dispatch({"type":"move","soldier":"A","hex":"V6"}).ok)
 assert("V6" in mine.state.minefields)
 assert(mine.state.blocked == "")
 mine.state.squad[0].hex = "U6"
 mine.forced_rolls = [9]
 assert(mine.dispatch({"type":"move","soldier":"A","hex":"V6"}).ok)
 assert(mine.state.blocked != "")
 var group_game = Game.new()
 group_game.new_game(19)
 group_game.state.squad[0].hex="A1"
 group_game.state.squad[1].hex="A1"
 var before = group_game.state.history.size()
 var result = group_game.dispatch({"type":"move_group","soldier":"A","group":["A","B"],"hex":"B1"})
 assert(result.ok)
 assert(group_game.soldier("A").hex == "B1")
 assert(group_game.soldier("B").hex == "B1")
 assert(group_game.state.history.size() <= before + 1)
 assert(not group_game.dispatch({"type":"move_group","soldier":"A","group":["A","B"],"hex":"T8"}).ok)
 print("SMOKE OK")
 quit()
