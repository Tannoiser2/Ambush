; Ambush! — edizione digitale italiana (Godot 4.7)
config_version=5

[application]
config/name="Ambush! · Sangue a Saint-Michaux"
config/description="Wargame tattico in solitario: Missione 1, Normandia 1944."
run/main_scene="res://scene/principale.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icona.png"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]
theme/default_font_antialiasing=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.11, 0.12, 0.09, 1)
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=3
