; Ambush! — edizione digitale italiana
config_version=5

[application]
config/name="Ambush! · Saint-Michaux"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Adattamento digitale italiano — prototipo delle Operazioni della missione 1"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/min_width=1060
window/size/min_height=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.07, 0.085, 0.07, 1)
